# ====================================================================
# Practical Pathways CRM — Environment Configuration Template
# PLACEHOLDERS ONLY — NEVER COMMIT REAL PRODUCTION SECRETS OR PASSWORDS
# ====================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase PostgreSQL & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"

# Meta Lead Ads Integration Secrets
META_APP_ID="your_meta_app_id_placeholder"
META_APP_SECRET="your_meta_app_secret_placeholder"
META_PAGE_ACCESS_TOKEN="your_meta_page_access_token_placeholder"
META_VERIFY_TOKEN="meta_verify_pracpathways_secret_token"

# Google Ads Native Lead Form Secret Key
GOOGLE_LEAD_FORM_KEY="google_lead_secret_key_pracpathways_2026"

# Transactional Email Provider (Resend / Postmark / SMTP)
RESEND_API_KEY="re_your_resend_api_key_placeholder"
EMAIL_SENDER_ADDRESS="info@pracpathways.com.au"
EMAIL_SENDER_NAME="Practical Pathways Admissions"

# Security & Tokens
UNSUBSCRIBE_SECRET="your_cryptographic_unsubscribe_secret_key_here"
CRON_SECRET="your_secure_worker_cron_bearer_token_here"

# WordPress Elementor Pro Webhook & HMAC Integration
PTP_ELEMENTOR_SECRET="ptp_elem_sec_your_hmac_secret_placeholder"
PTP_ELEMENTOR_SECRET_TOKEN="ptp_tok_your_fallback_token_placeholder"

# 3CX Phone System Integration
PTP_3CX_API_KEY="ptp_3cx_sec_your_bearer_api_key_placeholder"
PTP_3CX_PBX_URL="https://ptp.3cx.com.au:5001"
PTP_3CX_VERSION="v20" # v18 or v20
PTP_3CX_LICENCE_EDITION="Pro" # Pro or Enterprise / AI (Free/Standard does not support CRM)

