  "email_templates": [
    {
      "id": "tpl_001",
      "organization_id": "org_pracpathways_001",
      "name": "Lead Enquiry Acknowledgement",
      "slug": "welcome-acknowledgement",
      "subject": "Thank you for your enquiry — Practical Pathways",
      "body_html": "<div style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333;\">\n  <h2 style=\"color: #0A192F;\">Welcome to Practical Pathways</h2>\n  <p>Dear <strong>{{contact.name}}</strong>,</p>\n  <p>Thank you for submitting your enquiry to Practical Pathways. We have received your request regarding our programs.</p>\n  <p>One of our dedicated admissions advisors, <strong>{{agent.name}}</strong>, will contact you shortly to guide you through the process and answer any questions.</p>\n  <p>Best regards,<br><strong>Practical Pathways Admissions Team</strong><br>Email: info@pracpathways.com.au</p>\n  <hr style=\"border: none; border-top: 1px solid #eee; margin-top: 30px;\" />\n  <p style=\"font-size: 11px; color: #888;\">You are receiving this transactional confirmation because you submitted a form on our website. <a href=\"{{unsubscribe_url}}\" style=\"color: #888;\">Unsubscribe</a></p>\n</div>",
      "body_text": "Thank you for contacting Practical Pathways. An advisor will contact you shortly.",
      "variables": [
        "contact.name",
        "contact.email",
        "agent.name",
        "organization.name",
        "unsubscribe_url"
      ],
      "is_system": true,
      "is_active": true,
      "created_at": "2026-10-20T08:59:42.832Z",
      "updated_at": "2026-10-20T08:59:42.832Z"
    },
